{
  "name": "Aira — Pre-Consultation Intake",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd api && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "expo-web",
      "command": "cd app && EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1 npx expo start --web --port 8081"
    }
  ],
  "ports": [8000, 8081]
}
