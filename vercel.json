{
  "version": 2,
  "name": "sih2026-intake",
  "buildCommand": "cd app && npm ci && npx expo export --platform web",
  "outputDirectory": "app/dist",
  "installCommand": "cd app && npm ci",
  "framework": null,
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/api/openapi.json", "destination": "/api/index.py" },
    { "source": "/api/docs", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "env": {
    "PYTHONPATH": "api"
  }
}
